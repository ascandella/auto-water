{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  packageRules: [
    {
      matchManagers: ["cargo"],
      matchPackagePatterns: ["^esp-"],
      groupName: "esp crates",
    },
    {
      matchManagers: ["cargo"],
      matchPackagePatterns: ["^embassy-"],
      groupName: "embassy crates",
    },
  ],
}
